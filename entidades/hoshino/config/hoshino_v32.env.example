HOSHINO_OLLAMA_URL=http://127.0.0.1:11435/api/chat
HOSHINO_OLLAMA_HOST=127.0.0.1:11435
# Modelo de conversa local
HOSHINO_MODEL=hf.co/ccharnkij/Qwen3.5-9B-Uncensored-GGUF:Q4_K_M
HOSHINO_CONTEXT_TOKENS=16384
HOSHINO_NUM_PREDICT=4096
HOSHINO_KEEP_ALIVE=24h

# Saída: fala automaticamente quando a entrada foi falada; texto escrito fica em mensagem.
HOSHINO_FALAR_VOZ_AUTONOMO=1
HOSHINO_FALAR_VOZ_TEXTO=0

# Ouvido local (CPU para não disputar a VRAM do Qwen)
HOSHINO_WHISPER=large-v3
HOSHINO_TRANSCRITOR=faster
HOSHINO_AUDIO_DEVICE=cpu
HOSHINO_AUDIO_COMPUTE=int8
HOSHINO_AUDIO_CONTINUO=1
HOSHINO_AUDIO_MAX_ORADORES=2
HOSHINO_AUDIO_DIARIZACAO=0
HOSHINO_AUDIO_DIARIZACAO_MODELO=pyannote/speaker-diarization-community-1
# Preencha depois de aceitar os termos do modelo pyannote no Hugging Face.
HOSHINO_HF_TOKEN=

# Voz Hoshino: Kokoro-82M em worker Python 3.12, CPU/RAM
HOSHINO_TTS_BACKEND=kokoro
HOSHINO_TTS_MODEL=hexgrad/Kokoro-82M
HOSHINO_TTS_DEVICE=cpu
HOSHINO_TTS_KEEP_LOADED=1
# Depois da primeira geração automática, pode apontar para seu próprio WAV de referência.
# HOSHINO_TTS_REFERENCE=/caminho/para/hoshino_reference.wav

# Imagem local: pesos em RAM, difusão Vulkan com GPU arbitrada, encoder/VAE CPU.
# Backend atual: Qwen-Image 2.1 Q6_K (diffusion/encoder/VAE locais).
HOSHINO_IMAGE_MODEL=Qwen-Image-2.1-Q6_K
HOSHINO_IMAGE_DEVICE=vulkan0
HOSHINO_IMAGE_STEPS=16
HOSHINO_IMAGE_CFG=1.0
HOSHINO_IMAGE_WIDTH=768
HOSHINO_IMAGE_HEIGHT=768
HOSHINO_IMAGE_KEEP_LOADED=0
HOSHINO_TTS_VOICE=pf_dora
HOSHINO_TTS_SPEED=1.0
HOSHINO_IMAGE_BACKEND=te=cpu,diffusion=vulkan0,vae=cpu
HOSHINO_IMAGE_PARAMS_BACKEND=te=cpu,diffusion=cpu,vae=cpu
HOSHINO_IMAGE_MAX_VRAM_GIB=7.0
HOSHINO_IMAGE_SAMPLER=euler
HOSHINO_IMAGE_TIMEOUT=900
HOSHINO_IMAGE_SD_CLI="/home/gustavo/hoshino e lilith/compartilhado/servicos/stable-diffusion.cpp/build/bin/sd-cli"
