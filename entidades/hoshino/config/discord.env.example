# Token real do bot. Nunca publique este arquivo com o token preenchido.
HOSHINO_DISCORD_TOKEN=
HOSHINO_DISCORD_NOTIFICACOES=1

# Contatos que a Hoshino pode escolher pelo nome quando quiser iniciar uma DM.
# Formato: ID=Nome;ID2=Nome 2
# Exemplo: 123456789012345678=Joao;987654321098765432=Maria
HOSHINO_DISCORD_CONTATOS=

# Canais de servidor em que a Hoshino pode responder sem ser mencionada.
# IDs separados por vírgula.
HOSHINO_DISCORD_CANAIS=
