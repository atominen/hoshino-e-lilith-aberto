# Configuração exclusiva do adaptador Discord da Lilith.
# Nunca publique este arquivo com um token preenchido.
HOSHINO_DISCORD_TOKEN=
HOSHINO_DISCORD_NOTIFICACOES=1

# Contatos que a Lilith pode escolher pelo nome para iniciar uma DM.
# Formato: ID=Nome;ID2=Nome 2
HOSHINO_DISCORD_CONTATOS=

# Canais em que a Lilith pode responder sem ser mencionada.
# IDs separados por vírgula.
HOSHINO_DISCORD_CANAIS=
